<div class="basic-section">
  <h2>{{ section.settings.heading }}</h2>
  {% if section.settings.text != blank %}
    <p>{{ section.settings.text }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Basic section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hello from a basic section"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "This section was added to the home page."
    }
  ],
  "presets": [
    {
      "name": "Basic section"
    }
  ]
}
{% endschema %}
